{
  "name": "x-like-digest",
  "private": true,
  "type": "module",
  "workspaces": [
    "workers/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "wrangler dev -c workers/ingest/wrangler.jsonc -c workers/orchestrator/wrangler.jsonc -c workers/summarizer/wrangler.jsonc",
    "types": "npm run types --workspaces --if-present",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run lint && npm run check --workspaces --if-present",
    "test": "vitest run",
    "db:generate": "npm run db:generate -w @x-like-digest/shared",
    "db:migrate:local": "wrangler d1 migrations apply DB --local -c workers/ingest/wrangler.jsonc",
    "deploy": "npm run deploy --workspaces --if-present"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@cloudflare/vitest-plugin": "^1.4.11",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.0.0"
  }
}
