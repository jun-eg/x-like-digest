{
  "name": "x-like-digest",
  "private": true,
  "type": "module",
  "workspaces": [
    "workers/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "wrangler dev -c workers/ingest/wrangler.dev.jsonc -c workers/orchestrator/wrangler.jsonc -c workers/summarizer/wrangler.jsonc",
    "types": "npm run types --workspaces --if-present",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run lint && npm run check --workspaces --if-present",
    "deploy": "npm run deploy --workspaces --if-present"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "typescript": "^5.9.0",
    "wrangler": "^4.0.0"
  }
}
