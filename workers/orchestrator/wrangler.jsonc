{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "x-like-digest-orchestrator",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "observability": { "enabled": true },
  "triggers": { "crons": ["*/10 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "x-like-digest",
      "database_id": "6e69ba2f-5fde-43d4-ac47-38a9939f61a9",
      "migrations_dir": "../../packages/shared/migrations"
    }
  ],
  "services": [
    {
      "binding": "SUMMARIZER",
      "service": "x-like-digest-summarizer",
      "entrypoint": "Summarizer"
    }
  ]
}
